OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
# Reintentos de la cadena LCEL ante JSON invalido, truncamiento o error transitorio.
# Son reintentos, no intentos totales: 2 = 1 llamada inicial + 2 reintentos = 3 llamadas.
# Minimo 1 (la consigna exige al menos un reintento). El reintento interno del SDK
# queda deshabilitado a proposito (max_retries=0), este es el unico contador.
LLM_MAX_RETRIES=2
